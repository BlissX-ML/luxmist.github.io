{
    "name": "soluna",
    "version": "1.0.0",
    "description": "> 这是一个基于 React + Vite 构建的个人技术项目， > 主要用于实践前端工程化、内容渲染系统、数据可视化与交互设计相关能力， > 并作为长期维护的技术实验与作品展示平台。 > 同时已完成域名购入、域名解析、ICP备案与公安备案等完整上线部署流程，具备真实生产环境运行条件。",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "client": "npm run dev --prefix client",
        "server": "nodemon --watch server --ext js,ts,json --exec tsx server/server.js",
        "dev": "concurrently \"npm run server\" \"npm run client\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/BlissX-ML/soluna.github.io.git"
    },
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/BlissX-ML/soluna.github.io/issues"
    },
    "homepage": "https://github.com/BlissX-ML/soluna.github.io#readme",
    "devDependencies": {
        "@alicloud/pop-core": "^1.8.0",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "ali-oss": "^6.23.0",
        "concurrently": "^9.2.1",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "express-async-handler": "^1.2.0",
        "nodemon": "^3.1.14",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "dayjs": "^1.11.21",
        "gray-matter": "^4.0.3"
    }
}
